{
  "name": "bnts-print-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "test": "npm run build:cloudflare && node --test tests/*.test.js",
    "test:e2e": "npm run build:apps-script && npm run build:cloudflare && playwright test",
    "build:apps-script": "tsc --noEmit && vite build --config vite.apps-script.config.ts && node scripts/build-apps-script.js",
    "package:apps-script": "npm run build:apps-script && node scripts/package-apps-script.js",
    "dev:cloudflare": "wrangler dev",
    "build:cloudflare": "wrangler deploy --dry-run --outdir .cloudflare-build",
    "deploy": "wrangler deploy",
    "test:cloudflare": "npm run build:cloudflare && node --test tests/cloudflare.test.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "fflate": "^0.8.2",
    "googleapis": "^189.0.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "three-mesh-bvh": "^0.9.18",
    "yauzl": "^3.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "miniflare": "^4.20260730.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.4",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "^0.35.5",
      "undici": "^7.30.2"
    }
  }
}

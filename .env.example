# Copy to .env for local development. Never commit .env.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TEACHER_PASSWORD=
SESSION_SECRET=
# local = explicit development demo; drive = real Google Drive. Production requires drive.
STORAGE_MODE=local
PORT=3000
# Set NODE_ENV=production on your host (never for local demo storage).
# Connect Google from /teacher after configuring OAuth. See README.md.
PUBLIC_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional initial folder ID; otherwise enter its shared link in the teacher setup screen.
GOOGLE_DRIVE_FOLDER_ID=
# Separate random secret used by an external hourly retention trigger.
CLEANUP_SECRET=
